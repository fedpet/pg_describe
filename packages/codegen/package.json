{
  "name": "pg-describe-gen",
  "version": "1.0.0",
  "description": "Generate TypeScript types from plain .sql files, using the pg_describe PostgreSQL extension",
  "keywords": ["postgres", "postgresql", "typescript", "codegen", "sql", "types"],
  "license": "MIT",
  "author": "sajonaro",
  "homepage": "https://sajonaro.github.io/pg_describe/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sajonaro/pg_describe.git",
    "directory": "packages/codegen"
  },
  "bugs": {
    "url": "https://github.com/sajonaro/pg_describe/issues"
  },
  "type": "module",
  "bin": {
    "pg-describe-gen": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
